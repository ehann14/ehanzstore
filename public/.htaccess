Options -Indexes -ExecCGI

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# Blokir akses langsung ke file script (php, dll) demi keamanan.
# index.php dikecualikan: itu pintu masuk Laravel, kalau ikut diblokir seluruh
# website akan 403 Forbidden.
<FilesMatch "^(?!index\.php$).*\.(php|phtml|phar|pl|py|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Service worker & manifest HARUS selalu versi terbaru. Kalau tersimpan di cache (browser/Cloudflare),
# HP tetap memakai sw.js lama yang belum punya kode notifikasi push.
<FilesMatch "^(sw\.js|manifest\.json)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# HEMAT BANDWIDTH
# 1) Kompresi teks (HTML/CSS/JS/JSON/SVG): ukuran turun 70-80% saat dikirim.
# 2) Gambar statis disimpan browser lama (logo, ikon). Folder uploads punya aturan sendiri.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Teruskan permintaan ke Laravel jika file/folder tidak ditemukan
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>